---
import { SEO } from 'astro-seo';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Djangors: The Django of Rust',
  description = "Djangors is a batteries-included web framework for Rust. It brings Django's ORM, migrations, admin site, forms, auth, REST framework, background tasks, payments, and multi-tenancy to a single static binary with Rust's speed and safety.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.png', Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://djangors.vercel.app/#organization',
      name: 'Djangors',
      url: 'https://djangors.vercel.app/',
      logo: 'https://djangors.vercel.app/logo.svg',
      sameAs: ['https://github.com/Chidi09/djangors', 'https://crates.io/crates/djangors'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://djangors.vercel.app/#website',
      name: 'Djangors',
      url: 'https://djangors.vercel.app/',
      publisher: { '@id': 'https://djangors.vercel.app/#organization' },
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': 'https://djangors.vercel.app/#software',
      name: 'Djangors',
      description,
      codeRepository: 'https://github.com/Chidi09/djangors',
      programmingLanguage: 'Rust',
      license: 'https://github.com/Chidi09/djangors/blob/main/LICENSE-MIT',
      isPartOf: { '@id': 'https://djangors.vercel.app/#website' },
    },
  ],
};
---

<script>
  const copy = async (button: HTMLElement) => {
    await navigator.clipboard.writeText(button.dataset.markdown ?? '');
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy as Markdown'), 1400);
  };
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest<HTMLElement>('[data-markdown]');
    if (button) copy(button);
  });
</script>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <SEO
      title={title}
      description={description}
      canonical={canonicalURL.toString()}
      robotsExtras="max-image-preview:large"
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: ogImageURL.toString(),
          url: canonicalURL.toString(),
        },
        optional: { description, locale: 'en_US', siteName: 'Djangors' },
        image: { alt: 'Djangors — The Django of Rust', width: 1200, height: 630 },
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@djangors',
        title,
        description,
        image: ogImageURL.toString(),
        imageAlt: 'Djangors — The Django of Rust',
      }}
      extend={{ meta: [{ name: 'author', content: 'Djangors contributors' }] }}
    />
    <meta name="theme-color" content="#f27822" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body><header><a class="brand" href="/"><img src="/logo.svg" alt="Djangors logo" /><span class="brand-name">Djangors</span></a><nav><a href="/compare">Compare</a><a href="/benchmarks">Benchmarks</a><a href="/changelog">Changelog</a><a href="/docs/">Docs</a><a class="github" href="https://github.com/Chidi09/djangors">GitHub ↗</a></nav></header><main><slot /></main><footer><div class="footer-grid"><div><h4>Learn</h4><ul><li><a href="/docs/">Documentation</a></li><li><a href="/docs/tutorial/01-requests-and-responses.html">Tutorial</a></li><li><a href="/compare">Django comparison</a></li><li><a href="/benchmarks">Benchmarks</a></li></ul></div><div><h4>Project</h4><ul><li><a href="https://github.com/Chidi09/djangors/blob/main/PLAN.md">Roadmap</a></li><li><a href="/changelog">Changelog</a></li><li><a href="https://crates.io/search?q=djangors">crates.io</a></li><li><a href="https://github.com/Chidi09/djangors/blob/main/docs/src/api-stability.md">API stability policy</a></li></ul></div><div><h4>Get involved</h4><ul><li><a href="https://github.com/Chidi09/djangors">Source code</a></li><li><a href="https://github.com/Chidi09/djangors/issues">Report an issue</a></li><li><a href="https://github.com/Chidi09/djangors/pulls">Pull requests</a></li></ul></div><div><h4>License</h4><ul><li><a href="https://github.com/Chidi09/djangors/blob/main/LICENSE-MIT">MIT License</a></li><li><a href="https://github.com/Chidi09/djangors/blob/main/LICENSE-APACHE">Apache License 2.0</a></li></ul></div></div><div class="footer-bottom">Djangors &middot; The Django of Rust</div></footer></body>
</html>
