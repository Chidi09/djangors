---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Djangors: The Django of Rust',
  description = "Djangors is a batteries-included web framework for Rust. It brings Django's ORM, migrations, admin site, forms, auth, REST framework, background tasks, payments, and multi-tenancy to a single static binary with Rust's speed and safety.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og.png', Astro.site);
---

<script>
  const copy = async (button: HTMLElement) => {
    await navigator.clipboard.writeText(button.dataset.markdown ?? '');
    button.textContent = 'Copied';
    setTimeout(() => (button.textContent = 'Copy as Markdown'), 1400);
  };
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest<HTMLElement>('[data-markdown]');
    if (button) copy(button);
  });
</script>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f27822" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Djangors" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: 'Djangors',
      description: 'A batteries-included web framework for Rust, bringing Django-style productivity (ORM, migrations, admin, auth, REST framework, background tasks, payments, multi-tenancy) to Rust.',
      codeRepository: 'https://github.com/Chidi09/djangors',
      programmingLanguage: 'Rust',
      license: 'https://github.com/Chidi09/djangors/blob/main/LICENSE-MIT',
    })} />
  </head>
  <body><header><a class="brand" href="/"><img src="/logo.svg" alt="Djangors" /><span>Djangors</span></a><nav><a href="/compare">Compare</a><a href="/benchmarks">Benchmarks</a><a href="/changelog">Changelog</a><a href="/docs/">Docs</a><a class="github" href="https://github.com/Chidi09/djangors">GitHub ↗</a></nav></header><main><slot /></main><footer><div class="footer-grid"><div><h4>Learn</h4><ul><li><a href="/docs/">Documentation</a></li><li><a href="/docs/tutorial/01-requests-and-responses.html">Tutorial</a></li><li><a href="/compare">Django comparison</a></li><li><a href="/benchmarks">Benchmarks</a></li></ul></div><div><h4>Project</h4><ul><li><a href="https://github.com/Chidi09/djangors/blob/main/PLAN.md">Roadmap</a></li><li><a href="/changelog">Changelog</a></li><li><a href="https://crates.io/search?q=djangors">crates.io</a></li><li><a href="https://github.com/Chidi09/djangors/blob/main/docs/src/api-stability.md">API stability policy</a></li></ul></div><div><h4>Get involved</h4><ul><li><a href="https://github.com/Chidi09/djangors">Source code</a></li><li><a href="https://github.com/Chidi09/djangors/issues">Report an issue</a></li><li><a href="https://github.com/Chidi09/djangors/pulls">Pull requests</a></li></ul></div><div><h4>License</h4><ul><li><a href="https://github.com/Chidi09/djangors/blob/main/LICENSE-MIT">MIT License</a></li><li><a href="https://github.com/Chidi09/djangors/blob/main/LICENSE-APACHE">Apache License 2.0</a></li></ul></div></div><div class="footer-bottom">Djangors &middot; The Django of Rust</div></footer></body>
</html>
